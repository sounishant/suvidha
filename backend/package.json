{
  "name": "suvidha-backend",
  "version": "1.0.0",
  "description": "Suvidha backend",
  "scripts": {
    "dev": "node --env-file=../.env --watch src/server.ts",
    "start": "node src/server.ts",
    "typecheck": "tsc",
    "test": "vitest run --exclude \"test/db/**\"",
    "test:db": "node --env-file=../.env node_modules/vitest/vitest.mjs run test/db --no-file-parallelism --test-timeout=30000",
    "migrate": "node --env-file=../.env src/db/migrate.ts",
    "seed": "node --env-file=../.env src/db/seed.ts",
    "sim": "node --env-file=../.env simulator/run.ts",
    "create-photo-bucket": "node --env-file=../.env src/ops/create-photo-bucket.ts"
  },
  "type": "module",
  "dependencies": {
    "express": "^5.3.0",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "private": true,
  "engines": {
    "node": ">=24"
  }
}
