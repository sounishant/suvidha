# Copy to .env and fill in real values. Never commit .env.

# --- Bolna (voice agents) ---
BOLNA_API_KEY=NULL
BOLNA_AGENT_ID_CUSTOMER=NULL
BOLNA_AGENT_ID_WORKER=NULL
BOLNA_CUSTOMER_LINE_NUMBER=NULL
BOLNA_WORKER_LINE_NUMBER=NULL
# Shared secrets we generate ourselves; Bolna sends them on every function call and webhook.
BOLNA_FUNCTION_TOKEN=NULL
BOLNA_WEBHOOK_TOKEN=NULL

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_ACCESS_TOKEN=NULL
WHATSAPP_PHONE_NUMBER_ID=NULL
WHATSAPP_BUSINESS_ACCOUNT_ID=NULL
WHATSAPP_APP_SECRET=NULL
WHATSAPP_VERIFY_TOKEN=NULL
WHATSAPP_API_VERSION=v26.0

# --- Database (Supabase) ---
# Use the "Session pooler" connection string: it works from Railway and laptops.
DATABASE_URL=NULL
SUPABASE_URL=NULL
SUPABASE_ANON_KEY=NULL
SUPABASE_SERVICE_ROLE_KEY=NULL

# --- Google Maps Platform (Geocoding + Places) ---
GOOGLE_MAPS_API_KEY=NULL

# --- Public URLs ---
BACKEND_PUBLIC_URL=NULL
APP_PUBLIC_URL=NULL
GRIEVANCE_CONTACT=NULL

# --- Web app (Next.js) ---
NEXT_PUBLIC_API_URL=NULL
NEXT_PUBLIC_SUPABASE_URL=NULL
NEXT_PUBLIC_SUPABASE_ANON_KEY=NULL

# --- Dispatch timers (real use; stage values: 20 / 30 / 120) ---
RING_TIMEOUT_SEC=25
OFFER_TIMEOUT_SEC=60
CONFIRM_EXPIRY_SEC=600
TICK_SEC=3

# --- Seed workers (comma-separated, +91 format) ---
DEMO_WORKER_PHONES=NULL
